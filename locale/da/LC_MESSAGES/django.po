msgstr "Har du allerede en konto? Så %(link)s venligst %(end_link)s ind."

#: templates/account/signup.html:41
msgid "Sign up using a passkey"
msgstr "Tilmeld dig med en adgangsnøgle"

#: templates/account/signup_by_passkey.html:10
msgid "Passkey Sign Up"
msgstr "Passnøgle tilmelding"

#: templates/account/signup_by_passkey.html:38
msgid "Other options"
