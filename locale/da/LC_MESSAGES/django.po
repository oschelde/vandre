#: templates/account/email_confirm.html:20
#, python-format
msgid ""
"Please confirm that <a href=\"mailto:%(email)s\">%(email)s</a> is an email "
"address for user %(user_display)s."
msgstr ""
"Bekræft venligst, at det <a href=\"mailto:%(email)s\">%(email)s</a> er en e-"
"mailadresse til brugeren %(user_display)s."

#: templates/account/email_confirm.html:34
#, python-format
msgid ""
"Unable to confirm %(email)s because it is already confirmed by a different "
"account."
msgstr ""
"Kan ikke bekræfte %(email)s, fordi det allerede er bekræftet af en anden "
"konto."

#: templates/account/email_confirm.html:40
#, python-format
msgid ""
"This email confirmation link expired or is invalid. Please <a "
"href=\"%(email_url)s\">issue a new email confirmation request</a>."
msgstr ""
"Dette e-mailbekræftelseslink er udløbet eller ugyldigt. Send <a "
"href=\"%(email_url)s\">venligst en ny bekræftelsesanmodning via e-mail</a>."

#: templates/account/login.html:23
#, python-format
msgid ""
"If you have not created an account yet, then please %(link)ssign "
"up%(end_link)s first."
msgstr ""
"Hvis du endnu ikke har oprettet en konto, så %(link)stilmeld dig venligst "
"først%(end_link)s."

#: templates/account/login.html:43
msgid "Sign in with a passkey"
msgstr "Log ind med en adgangsnøgle"

#: templates/account/login.html:48 templates/account/request_login_code.html:10
