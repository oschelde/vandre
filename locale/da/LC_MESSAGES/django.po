#: templates/account/password_reset_from_key_done.html:10
#: templates/core/include/navbar.html:46
msgid "Change Password"
msgstr "Skift adgangskode"

#: templates/account/password_reset.html:19
msgid ""
"Forgotten your password? Enter your email address below, and we'll send you "
"an email allowing you to reset it."
msgstr ""
"Har du glemt din adgangskode? Indtast din e-mailadresse nedenfor, så sender "
"vi dig en e-mail, hvor du kan nulstille den."

#: templates/account/password_reset.html:29
msgid "Reset My Password"
msgstr "Nulstil adgangskode"

#: templates/account/password_reset.html:33
msgid "Please contact us if you have any trouble resetting your password."
msgstr ""
"Kontakt os venligst, hvis du har problemer med at nulstille din adgangskode."

#: templates/account/password_reset_done.html:17
msgid ""
"We have sent you an email. If you have not received it please check your "
"spam folder. Otherwise contact us if you do not receive it in a few minutes."
msgstr ""
"Vi har sendt dig en e-mail. Hvis du ikke har modtaget den, bedes du tjekke "
"din spam-mappe. Ellers kontakt os, hvis du ikke modtager den inden for få "
"minutter."

#: templates/account/password_reset_from_key.html:11
msgid "Bad Token"
msgstr "Dårlig Token"

#: templates/account/password_reset_from_key.html:19
#, python-format
msgid ""
"The password reset link was invalid, possibly because it has already been "
"used.  Please request a <a href=\"%(passwd_reset_url)s\">new password reset</"
"a>."
msgstr ""
"Adgangskodenulstillingslinket var ugyldigt, muligvis fordi det allerede er "
"blevet brugt.  Anmod venligst om en <a href=\"%(passwd_reset_url)s\">ny "
"adgangskodenulstilling</a>."

#: templates/account/password_reset_from_key_done.html:13
msgid "Your password is now changed."
msgstr "Din adgangskode er nu ændret."

